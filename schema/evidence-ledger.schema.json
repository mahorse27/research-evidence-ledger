{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mahorse27/research-evidence-ledger/raw/main/schema/evidence-ledger.schema.json",
  "title": "Research Evidence Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "entries"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "created_at", "updated_at"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "citation": { "type": "string", "minLength": 1 },
        "doi": { "type": "string", "pattern": "^10\\.\\d{4,9}/\\S+$" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "claim",
        "source",
        "basis",
        "test_plan",
        "resolution_plan",
        "tags",
        "notes",
        "created_at"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[FIHG]-\\d{3,}$" },
        "kind": {
          "enum": ["literature_fact", "formal_inference", "hypothesis", "evidence_gap"]
        },
        "claim": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/source" },
        "basis": { "$ref": "#/$defs/stringList" },
        "test_plan": { "$ref": "#/$defs/stringList" },
        "resolution_plan": { "$ref": "#/$defs/stringList" },
        "tags": { "$ref": "#/$defs/stringList" },
        "notes": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "formal_inference" } } },
          "then": { "properties": { "basis": { "minItems": 1 } } }
        }
      ]
    }
  }
}
